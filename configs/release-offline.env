# Standalone delivery profile; no workspace dependency.
HOST=127.0.0.1
PORT=8088
MEMORY_DATA_DIR=.data-offline
# V1 offline candidate: deterministic limited extraction, lexical search; no model equivalence claim.
MEMORY_MODE=offline
MEMORY_ADD_TIMEOUT_MS=115000
MEMORY_SEARCH_TIMEOUT_MS=55000
MEMORY_MAX_EVIDENCE=32
MEMORY_TOKEN_BUDGET=6000
MEMORY_RETRIEVAL=lexical
MEMORY_SOURCE_INDEX=true
MEMORY_SOURCE_FIRST=false
MEMORY_SOURCE_OPERATIONS=false
MEMORY_SOURCE_OPERATION_HISTORY=false
MEMORY_SOURCE_OPERATION_BATCHES=false
MEMORY_SOURCE_OPERATION_ROUTING=false
MEMORY_ERASURE_BINDING=false
MEMORY_SOURCE_ERASURE=false
MEMORY_SEMANTIC_TRANSITIONS=false
MEMORY_WRITE_CONTINUATION=false
MEMORY_RERANK=false
MEMORY_COVERAGE_PACKING=true
MEMORY_EVENT_VIEW=true
MEMORY_RELATION_MODE=off
MEMORY_EXPERIMENT_MULTI_HOP=false
# Pattern cards (deterministic cross-session aggregation of multiple-cardinality
# facts) stay visible in retrieval and are produced on plain content adds.
MEMORY_EXPERIMENT_AGGREGATE=true
# Multi-source corroboration ranks a conflicted value restated by >=2 independent
# statements above its single-source rival; the conflict itself stays unresolved.
MEMORY_EXPERIMENT_CORROBORATION=true
MEMORY_EXPERIMENT_RAW_ONLY=false
MEMORY_EXPERIMENT_LIFECYCLE=true
MEMORY_EXPERIMENT_TEMPORAL=true
MEMORY_SOURCE_ERASURE_GROUPED=false
MEMORY_SOURCE_ERASURE_WORKERS=1
MEMORY_EXTRACTION_WORKERS=1

# Explicit defaults: do not inherit experimental query or trace behavior.
MEMORY_EXPERIMENT_REFLECTION=true
MEMORY_QUERY_FOCUS=false
MEMORY_MODEL_MIN_INTERVAL_MS=0
MEMORY_MODEL_TRACE=
MEMORY_MODEL_AUDIT=
