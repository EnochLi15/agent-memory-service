# 原生模型模式完整配置。复制为 .env 后修改模型地址与凭据，再执行 npm start。
# 默认无模型启动使用 npm run start:offline。
HOST=127.0.0.1
PORT=8088
MEMORY_DATA_DIR=.data-enhanced
MEMORY_MODE=enhanced
MEMORY_LLM_BASE_URL=http://127.0.0.1:8080/v1
MEMORY_LLM_API_KEY=
MEMORY_LLM_MODEL=gpt-5.4-mini
MEMORY_EXTRACTION_MODEL=gpt-5.5
MEMORY_VERIFICATION_MODEL=gpt-5.5
MEMORY_REPAIR_MODEL=gpt-5.5
MEMORY_LLM_REASONING_EFFORT=low
MEMORY_VERIFICATION_FORMAT=compact
MEMORY_INCREMENTAL_VERIFICATION=true
MEMORY_MAX_REPAIR_ROUNDS=2
MEMORY_EMBEDDING_BASE_URL=http://127.0.0.1:11434
MEMORY_EMBEDDING_API_KEY=
MEMORY_EMBEDDING_MODEL=nomic-embed-text:latest
MEMORY_EMBEDDING_DIMENSIONS=768
MEMORY_EMBEDDING_DIGEST=0a109f422b47e3a30ba2b10eca18548e944e8a23073ee3f3e947efcf3c45e59f
MEMORY_ADD_TIMEOUT_MS=115000
MEMORY_SEARCH_TIMEOUT_MS=55000
MEMORY_MAX_EVIDENCE=32
MEMORY_TOKEN_BUDGET=6000
MEMORY_RETRIEVAL=hybrid
MEMORY_SOURCE_INDEX=true
MEMORY_CANDIDATE_LIMIT=200
MEMORY_RERANK_CANDIDATES=80
MEMORY_RAW_FALLBACK=true
MEMORY_RERANK=false
MEMORY_COVERAGE_PACKING=true
MEMORY_EVENT_VIEW=true
MEMORY_EXPERIMENT_LIFECYCLE=true
MEMORY_EXPERIMENT_TEMPORAL=true
MEMORY_EXPERIMENT_MULTI_HOP=false
MEMORY_EXPERIMENT_AGGREGATE=true
MEMORY_EXPERIMENT_CORROBORATION=true
MEMORY_EXPERIMENT_RAW_ONLY=false
MEMORY_VERIFICATION_RESPONSE_FORMAT=json_schema
MEMORY_ERASURE_BINDING=true
MEMORY_SOURCE_ERASURE=true
MEMORY_SEMANTIC_TRANSITIONS=true
MEMORY_EXTRACTION_FORMAT=source_refs
MEMORY_SOURCE_OPERATIONS=false
MEMORY_SOURCE_OPERATION_HISTORY=false
MEMORY_SOURCE_OPERATION_BATCHES=false
MEMORY_SOURCE_OPERATION_ROUTING=false
MEMORY_SOURCE_FIRST=false
MEMORY_EXTRACTION_WORKERS=3
MEMORY_SOURCE_ERASURE_WORKERS=3
MEMORY_SOURCE_ERASURE_GROUPED=true
MEMORY_MODEL_TRANSPORT_ATTEMPTS=3
MEMORY_WRITE_CONTINUATION=false
MEMORY_RELATION_MODE=off
MEMORY_EXPERIMENT_REFLECTION=true
MEMORY_QUERY_FOCUS=false
MEMORY_MODEL_MIN_INTERVAL_MS=0
MEMORY_MODEL_TRACE=
MEMORY_MODEL_AUDIT=
