HOST=0.0.0.0
PORT=8088
MEMORY_DATA_DIR=.data
MEMORY_MODE=offline
MEMORY_LLM_BASE_URL=http://127.0.0.1:11434/v1
MEMORY_LLM_API_KEY=
MEMORY_LLM_MODEL=gpt-5.4-mini
# Optional gateway-supported reasoning effort: low | medium | high
# MEMORY_LLM_REASONING_EFFORT=low
MEMORY_INCREMENTAL_VERIFICATION=true
# Experimental output encoding: verbose (default) | compact
MEMORY_VERIFICATION_FORMAT=verbose
# 1 (default) or 2; both share the same absolute write/model deadline.
MEMORY_MAX_REPAIR_ROUNDS=1
# Optional stage overrides; unset stages use MEMORY_LLM_MODEL.
# MEMORY_EXTRACTION_MODEL=gpt-5.4-mini
# MEMORY_VERIFICATION_MODEL=gpt-5.5
# MEMORY_REPAIR_MODEL=gpt-5.5
MEMORY_EMBEDDING_BASE_URL=http://127.0.0.1:11434
MEMORY_EMBEDDING_MODEL=nomic-embed-text:latest
MEMORY_EMBEDDING_DIMENSIONS=768
MEMORY_EMBEDDING_DIGEST=0a109f422b47e3a30ba2b10eca18548e944e8a23073ee3f3e947efcf3c45e59f
MEMORY_ADD_TIMEOUT_MS=115000
MEMORY_SEARCH_TIMEOUT_MS=55000
MEMORY_MAX_EVIDENCE=32
MEMORY_TOKEN_BUDGET=6000
MEMORY_RETRIEVAL=hybrid
MEMORY_RERANK=false
MEMORY_RAW_FALLBACK=true
MEMORY_SOURCE_INDEX=true
MEMORY_CANDIDATE_LIMIT=200
MEMORY_RERANK_CANDIDATES=80
MEMORY_COVERAGE_PACKING=true
MEMORY_EVENT_VIEW=true

# Opt-in semantic erasure scope binding; requires a fresh v3 data directory.
MEMORY_ERASURE_BINDING=false

# Opt-in source paraphrase checks; requires ERASURE_BINDING and a fresh v4 directory.
MEMORY_SOURCE_ERASURE=false
# 1 (default), 2 or 3 classification workers; one global quote repair, shared deadline.
MEMORY_SOURCE_ERASURE_WORKERS=1

# Require fresh v5 data; verify implicit single-value state transitions.
MEMORY_SEMANTIC_TRANSITIONS=false

# Optional private diagnostic JSONL; includes model inputs/outputs, never HTTP credentials.
# MEMORY_MODEL_TRACE=/absolute/private/path/model-trace.jsonl

# Experimental initial output organization: flat | message_groups | source_refs.
# All formats retain independent coverage verification.
MEMORY_EXTRACTION_FORMAT=flat
# Experimental grouped extraction: 1 (default), 2 or 3; at least four participants.
# Full context is repeated in every shard. Use fresh comparison runs.
MEMORY_EXTRACTION_WORKERS=1

# Experimental current-chunk assistant-source rejection; requires enhanced mode,
# semantic transitions, lifecycle enabled and a fresh v6 directory.
MEMORY_SOURCE_OPERATIONS=false

# Complete bounded historical source catalog; requires SOURCE_OPERATIONS and fresh v7.
MEMORY_SOURCE_OPERATION_HISTORY=false

# Experimental: review all authorized boundaries together for each exact source.
MEMORY_SOURCE_ERASURE_GROUPED=false

# Explicit bounded preparation-response replay; requires fresh enhanced ingestion.
MEMORY_WRITE_CONTINUATION=false
